---
// Illustrative Bollinger-band chart. The series is synthetic (seeded, so the
// build is deterministic) — a nod to the NIFTY 50 project, not real market data.

const W = 560;
const H = 300;
const PAD = { t: 18, r: 14, b: 22, l: 14 };
const N = 150;
const WIN = 20;

// mulberry32: tiny seeded PRNG
function rng(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const rand = rng(436);
const gauss = () => {
  const u = 1 - rand();
  const v = rand();
  return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
};

// Mean-reverting walk with GARCH-flavoured volatility clustering.
const price: number[] = [];
let p = 100;
let sigma = 0.6;
let eps = 0;
for (let i = 0; i < N + WIN; i++) {
  sigma = Math.sqrt(0.05 + 0.18 * eps * eps + 0.78 * sigma * sigma);
  eps = sigma * gauss();
  p += 0.06 * (101 + 3 * Math.sin(i / 23) - p) + eps;
  price.push(p);
}

const mid: number[] = [];
const up: number[] = [];
const lo: number[] = [];
for (let i = WIN; i < N + WIN; i++) {
  const w = price.slice(i - WIN + 1, i + 1);
  const m = w.reduce((a, b) => a + b, 0) / WIN;
  const sd = Math.sqrt(w.reduce((a, b) => a + (b - m) ** 2, 0) / WIN);
  mid.push(m);
  up.push(m + 2 * sd);
  lo.push(m - 2 * sd);
}
const px = price.slice(WIN);

const all = [...up, ...lo, ...px];
const min = Math.min(...all);
const max = Math.max(...all);
const x = (i: number) => PAD.l + (i / (N - 1)) * (W - PAD.l - PAD.r);
const y = (v: number) => PAD.t + (1 - (v - min) / (max - min)) * (H - PAD.t - PAD.b);
const line = (s: number[]) => s.map((v, i) => `${i ? 'L' : 'M'}${x(i).toFixed(1)},${y(v).toFixed(1)}`).join('');

const band =
  line(up) +
  lo
    .map((v, i) => [i, v] as const)
    .reverse()
    .map(([i, v]) => `L${x(i).toFixed(1)},${y(v).toFixed(1)}`)
    .join('') +
  'Z';

// Entry signals: price closes back inside after piercing the lower band.
const signals: { cx: number; cy: number; delay: number }[] = [];
for (let i = 1; i < N; i++) {
  if (px[i - 1] < lo[i - 1] && px[i] >= lo[i]) {
    signals.push({ cx: x(i), cy: y(px[i]), delay: 0.6 + (i / N) * 2.2 });
  }
}

const gridY = [0.25, 0.5, 0.75].map((f) => PAD.t + f * (H - PAD.t - PAD.b));
---

<figure class="bands card" aria-label="Illustrative chart: a price series inside Bollinger bands, with entry signals marked">
  <figcaption class="bands__head">
    <span class="mono">NIFTY&nbsp;50 · 1m · BB(20,&nbsp;2σ)</span>
    <span class="bands__pill mono">illustrative</span>
  </figcaption>

  <svg viewBox={`0 0 ${W} ${H}`} class="bands__svg" role="img" aria-hidden="true">
    {gridY.map((gy) => <line x1={PAD.l} x2={W - PAD.r} y1={gy} y2={gy} class="bands__grid" />)}
    <path d={band} class="bands__area" />
    <path d={line(up)} class="bands__edge" pathLength="1" />
    <path d={line(lo)} class="bands__edge" pathLength="1" />
    <path d={line(mid)} class="bands__mid" />
    <path d={line(px)} class="bands__price" pathLength="1" />
    {signals.map((s) => (
      <g class="bands__sig" style={`animation-delay:${s.delay.toFixed(2)}s`}>
        <circle cx={s.cx} cy={s.cy} r="9" class="bands__sig-halo" />
        <circle cx={s.cx} cy={s.cy} r="3.6" class="bands__sig-dot" />
      </g>
    ))}
  </svg>

  <div class="bands__foot">
    <ul class="bands__legend mono">
      <li><i class="k k--price"></i>price</li>
      <li><i class="k k--band"></i>μ ± 2σ</li>
      <li><i class="k k--sig"></i>entry</li>
    </ul>
    <p class="bands__eq" title="GARCH(1,1) conditional variance">
      σ<sup>2</sup><sub>t</sub> = ω + α ε<sup>2</sup><sub>t−1</sub> + β σ<sup>2</sup><sub>t−1</sub>
    </p>
  </div>
</figure>

<style>
  .bands {
    margin: 0;
    padding: 16px 16px 14px;
    position: relative;
    overflow: hidden;
  }
  .bands__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: var(--fs-label);
    color: var(--muted);
    padding: 0 2px 10px;
  }
  .bands__pill {
    font-size: 0.6875rem;
    padding: 3px 8px;
    border-radius: 999px;
    border: 1px solid var(--line);
    color: var(--muted);
  }
  .bands__svg { display: block; width: 100%; height: auto; overflow: visible; }

  .bands__grid { stroke: var(--line); stroke-width: 1; stroke-dasharray: 2 5; }
  .bands__area { fill: var(--teal-soft); opacity: 0; animation: fade 1.2s 0.4s ease forwards; }
  .bands__edge {
    fill: none; stroke: var(--teal); stroke-width: 1.2; opacity: 0.8;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 2.4s 0.2s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }
  .bands__mid {
    fill: none; stroke: var(--accent); stroke-width: 1; stroke-dasharray: 3 4; opacity: 0;
    animation: fade 1s 1.2s ease forwards;
  }
  .bands__price {
    fill: none; stroke: var(--text); stroke-width: 1.6; stroke-linejoin: round;
    stroke-dasharray: 1; stroke-dashoffset: 1;
    animation: draw 3s 0.5s cubic-bezier(0.45, 0, 0.2, 1) forwards;
  }
  .bands__sig { opacity: 0; animation: pop 0.5s ease forwards; transform-box: fill-box; transform-origin: center; }
  .bands__sig-dot { fill: var(--accent); }
  .bands__sig-halo { fill: var(--accent-soft); stroke: var(--accent); stroke-opacity: 0.35; }

  .bands__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    padding: 10px 2px 0;
    border-top: 1px dashed var(--line);
    margin-top: 8px;
  }
  .bands__legend { display: flex; gap: 14px; margin: 0; padding: 0; list-style: none; font-size: var(--fs-label); color: var(--muted); }
  .bands__legend li { display: flex; align-items: center; gap: 6px; }
  .k { display: inline-block; width: 14px; height: 2px; border-radius: 2px; }
  .k--price { background: var(--text); }
  .k--band { background: var(--teal); height: 8px; opacity: 0.6; }
  .k--sig { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); }
  .bands__eq { margin: 0; font-family: var(--serif); font-size: 1.125rem; font-style: italic; color: var(--text-2); white-space: nowrap; }
  .bands__eq sub, .bands__eq sup { font-size: 0.62em; }

  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes pop {
    0% { opacity: 0; transform: scale(0.2); }
    70% { opacity: 1; transform: scale(1.25); }
    100% { opacity: 1; transform: scale(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .bands__area, .bands__mid, .bands__sig { animation: none; opacity: 1; }
    .bands__edge, .bands__price { animation: none; stroke-dashoffset: 0; }
  }
</style>
