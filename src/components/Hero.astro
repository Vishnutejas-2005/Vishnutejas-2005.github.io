---
import { profile } from '../data/resume';
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__text">
        <h1 class="hero__name display">
          JS Vishnu <em>Teja</em>
        </h1>
        <p class="hero__role sc">
          <span class="hero__live" aria-hidden="true"></span>
          {profile.programme}&nbsp;· IISc Bengaluru&nbsp;· Class of {profile.classOf}
        </p>
        <p class="hero__pitch">{profile.pitch}</p>
        <div class="hero__cta">
          <a href="#projects" class="btn btn--solid">
            See the work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
          </a>
          <a href={`mailto:${profile.emails[0]}`} class="btn btn--ghost">
            <span class="mono">{profile.emails[0]}</span>
          </a>
        </div>
      </div>

      <figure class="hero__photo card">
        <img src="/vishnu.png" alt="J S Vishnu Teja in a lecture hall" width="878" height="735" />
      </figure>
    </div>
  </div>
</section>

<style>
  .hero { padding: clamp(36px, 7vw, 88px) 0 0; }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); }
  }

  .hero__photo {
    margin: 0;
    padding: 10px;
    overflow: hidden;
  }
  .hero__photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) - 6px);
  }

  .hero__text { container-type: inline-size; }
  .hero__role {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 20px 0 0;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    text-wrap: balance;
  }
  .hero__live {
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: ping 2.4s infinite;
    flex: none;
    margin-top: 0.45em;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    80%, 100% { box-shadow: 0 0 0 9px transparent; }
  }

  /* Sized off the text column, not the viewport, so the name holds one line
     wherever it fits and breaks cleanly before "Teja" where it doesn't. */
  .hero__name {
    margin: 0;
    font-size: clamp(2.75rem, 13cqi, 5.5rem);
    line-height: 1;
    color: var(--text);
  }
  .hero__name em { color: var(--accent); white-space: nowrap; }

  .hero__pitch {
    margin: 18px 0 0;
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 18px;
    border-radius: 12px;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: transform 0.2s, background 0.2s, border-color 0.2s, color 0.2s;
    max-width: 100%;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn--solid { background: var(--accent); color: var(--accent-ink); }
  .btn--ghost { border: 1px solid var(--line); color: var(--text); background: var(--surface); }
  .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn--ghost .mono { font-size: 0.8125rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; }

</style>
