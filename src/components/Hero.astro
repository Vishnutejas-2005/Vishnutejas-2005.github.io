---
import BandsChart from './BandsChart.astro';
import { profile, stats } from '../data/resume';
---

<section id="top" class="hero">
  <div class="wrap">
    <div class="hero__grid">
      <div class="hero__text">
        <h1 class="hero__name display">
          J S Vishnu <em>Teja</em>
        </h1>
        <p class="hero__role sc">
          <span class="hero__live" aria-hidden="true"></span>
          {profile.programme}&nbsp;· IISc Bengaluru&nbsp;· Class of {profile.classOf}
        </p>
        <p class="hero__pitch">{profile.pitch}</p>
        <div class="hero__cta">
          <a href="#projects" class="btn btn--solid">
            See the work
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
          </a>
          <a href={`mailto:${profile.emails[0]}`} class="btn btn--ghost">
            <span class="mono">{profile.emails[0]}</span>
          </a>
        </div>
      </div>

      <div class="hero__chart">
        <BandsChart />
      </div>
    </div>

    <dl class="stats">
      {stats.map((s) => (
        <div class="stat">
          <dt class="label">{s.label}</dt>
          <dd>
            <span class="stat__v figure">{s.value}</span>
            <span class="stat__u label">{s.unit}</span>
          </dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .hero { padding: clamp(36px, 7vw, 88px) 0 0; }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(28px, 5vw, 64px);
    align-items: center;
  }
  @media (max-width: 980px) {
    .hero__grid { grid-template-columns: minmax(0, 1fr); }
  }

  .hero__text { container-type: inline-size; }
  .hero__role {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    margin: 20px 0 0;
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text);
    text-wrap: balance;
  }
  .hero__live {
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent);
    box-shadow: 0 0 0 0 var(--accent);
    animation: ping 2.4s infinite;
    flex: none;
    margin-top: 0.45em;
  }
  @keyframes ping {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--accent) 55%, transparent); }
    80%, 100% { box-shadow: 0 0 0 9px transparent; }
  }

  /* Sized off the text column, not the viewport, so the name holds one line
     wherever it fits and breaks cleanly before "Teja" where it doesn't. */
  .hero__name {
    margin: 0;
    font-size: clamp(2.75rem, 13cqi, 5.5rem);
    line-height: 1;
    color: var(--text);
  }
  .hero__name em { color: var(--accent); white-space: nowrap; }

  .hero__pitch {
    margin: 18px 0 0;
    max-width: 44ch;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--text-2);
    text-wrap: pretty;
  }

  .hero__cta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 30px; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 44px;
    padding: 0 18px;
    border-radius: 12px;
    font-size: var(--fs-small);
    font-weight: 700;
    letter-spacing: 0.01em;
    transition: transform 0.2s, background 0.2s, border-color 0.2s, color 0.2s;
    max-width: 100%;
  }
  .btn:hover { transform: translateY(-2px); }
  .btn--solid { background: var(--accent); color: var(--accent-ink); }
  .btn--ghost { border: 1px solid var(--line); color: var(--text); background: var(--surface); }
  .btn--ghost:hover { border-color: var(--accent); color: var(--accent); }
  .btn--ghost .mono { font-size: 0.8125rem; font-weight: 500; overflow: hidden; text-overflow: ellipsis; }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(40px, 6vw, 72px) 0 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .stat { padding: 20px clamp(12px, 2vw, 24px) 18px; }
  .stat + .stat { border-left: 1px solid var(--line); }
  .stat dt { margin: 0; }
  .stat dd { margin: 6px 0 0; display: flex; align-items: baseline; gap: 6px; }
  .stat dd { margin-top: 10px; flex-wrap: wrap; row-gap: 4px; }
  .stat__v { font-size: var(--fs-num); color: var(--text); }
  .stat__u { color: var(--accent); }
  .stat dt { font-size: var(--fs-label); }

  @media (max-width: 720px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .stat:nth-child(3) { border-left: 0; }
    .stat:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
