---
import { socials } from '../data/resume';

interface Props {
  /** On sub-pages, section links point back to the homepage. */
  home?: boolean;
}
const { home = true } = Astro.props;
const base = home ? '' : '/';

const links = [
  { id: 'experience', label: 'Experience' },
  { id: 'projects', label: 'Projects' },
  { id: 'skills', label: 'Toolkit' },
  { id: 'leadership', label: 'Leadership' },
  { id: 'contact', label: 'Contact' },
];
---

<header class="nav">
  <div class="wrap nav__inner">
    <a href={home ? '#top' : '/'} class="nav__mark" aria-label="J S Vishnu Teja, home">
      <span class="display"><em>jsv<span class="nav__t">t</span></em></span>
    </a>

    <nav class="nav__links" aria-label="Sections">
      {links.map((l) => (
        <a href={`${base}#${l.id}`} data-spy={l.id}>{l.label}</a>
      ))}
    </nav>

    <div class="nav__tools">
      {socials.map((s) => (
        <a href={s.href} class="nav__icon" aria-label={s.label} title={s.label} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d={s.path} /></svg>
        </a>
      ))}
      <button type="button" class="nav__icon" id="theme-toggle" aria-label="Toggle light and dark theme" title="Toggle theme">
        <svg class="i-sun" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
        </svg>
        <svg class="i-moon" viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
        </svg>
      </button>
    </div>
  </div>
</header>

<style is:global>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
            backdrop-filter: blur(14px) saturate(1.2);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s;
  }
  .nav.is-scrolled { border-bottom-color: var(--line); }

  .nav__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    height: 64px;
  }

  .nav__mark {
    font-size: 1.625rem;
    color: var(--text);
    line-height: 1;
  }
  .nav__t { color: var(--accent); }
  .nav__dot { color: var(--accent); font-weight: 700; font-size: 1.625rem; }

  .nav__links {
    display: flex;
    justify-content: center;
    gap: 4px;
  }
  .nav__links a {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--text-2);
    padding: 7px 12px;
    border-radius: 999px;
    transition: color 0.2s, background 0.2s;
  }
  .nav__links a:hover { color: var(--text); background: var(--surface-2); }
  .nav__links a[aria-current="true"] { color: var(--accent); background: var(--accent-soft); }

  .nav__tools { display: flex; gap: 6px; align-items: center; }
  .nav__icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    color: var(--text-2);
    background: transparent;
    border: 1px solid var(--line);
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, transform 0.2s;
  }
  .nav__icon:hover { color: var(--accent); border-color: var(--accent); transform: translateY(-1px); }

  /* Show the icon for the theme you'd switch *to*. */
  .i-sun { display: block; }
  .i-moon { display: none; }
  :root[data-theme="light"] .i-sun { display: none; }
  :root[data-theme="light"] .i-moon { display: block; }
  @media (prefers-color-scheme: light) {
    :root:not([data-theme="dark"]) .i-sun { display: none; }
    :root:not([data-theme="dark"]) .i-moon { display: block; }
  }

  @media (max-width: 860px) {
    .nav__inner {
      grid-template-columns: auto 1fr;
      grid-template-rows: 56px auto;
      height: auto;
      row-gap: 0;
    }
    .nav__tools { grid-row: 1; grid-column: 2; justify-self: end; }
    .nav__links {
      grid-row: 2;
      grid-column: 1 / -1;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      margin: 0 calc(var(--gutter) * -1);
      padding: 0 var(--gutter) 10px;
    }
    .nav__links::-webkit-scrollbar { display: none; }
    .nav__links a { white-space: nowrap; padding: 6px 11px; }
  }
</style>

<script>
  const root = document.documentElement;
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
    const next = current === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });

  const nav = document.querySelector('.nav');
  const onScroll = () => nav?.classList.toggle('is-scrolled', window.scrollY > 8);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Scroll-spy: the active section is the last one whose top has passed 40%
  // of the viewport (or the last section once the page bottoms out).
  const pills = document.querySelectorAll<HTMLAnchorElement>('[data-spy]');
  const targets = [...pills]
    .map((p) => document.getElementById(p.dataset.spy!))
    .filter((el): el is HTMLElement => el !== null);
  let ticking = false;
  const spy = () => {
    ticking = false;
    const line = window.innerHeight * 0.4;
    const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 4;
    let active = '';
    for (const t of targets) if (t.getBoundingClientRect().top <= line) active = t.id;
    if (atBottom && targets.length) active = targets[targets.length - 1].id;
    pills.forEach((p) => p.setAttribute('aria-current', String(p.dataset.spy === active)));
  };
  if (targets.length) {
    spy();
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(spy); }
    }, { passive: true });
  }
</script>
