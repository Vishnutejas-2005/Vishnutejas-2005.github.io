---
import SectionHead from './SectionHead.astro';
import { projects } from '../data/resume';
---

<section id="projects" class="section">
  <div class="wrap">
    <SectionHead title="Projects" meta={`${projects.length} entries`} />

    <div class="pj">
      {projects.map((p) => {
        const Tag = p.href ? 'a' : 'article';
        return (
          <Tag
            class:list={['pj__card card reveal', { 'pj__card--wide': p.featured, 'pj__card--link': p.href }]}
            href={p.href}
            {...(p.href?.startsWith('http') ? { target: '_blank', rel: 'noreferrer' } : {})}
          >
            <p class="pj__dates label">{p.dates}</p>

            <h3 class="pj__title">
              {p.title}
              {p.href && (
                <svg class="pj__arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M7 7h10v10" />
                </svg>
              )}
            </h3>
            <p class="pj__ctx"><em>{p.context}</em></p>

            {p.metric && (
              <p class="pj__metric">
                <span class="pj__metric-v figure">{p.metric.value}</span>
                <span class="pj__metric-l">{p.metric.label}</span>
              </p>
            )}

            <p class="pj__summary">{p.summary}</p>

            {p.points.length > 0 && (
              <ul class="bullets pj__points">{p.points.map((pt) => <li>{pt}</li>)}</ul>
            )}

            <ul class="tags pj__tags">{p.tags.map((t) => <li class="tag">{t}</li>)}</ul>

            {p.href && <span class="pj__cta">{p.cta ?? 'Read the case study →'}</span>}
          </Tag>
        );
      })}
    </div>
  </div>
</section>

<style>
  .pj {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  @media (max-width: 820px) {
    .pj { grid-template-columns: minmax(0, 1fr); }
  }

  .pj__card {
    display: flex;
    flex-direction: column;
    padding: clamp(20px, 3vw, 28px);
    transition: border-color 0.25s, transform 0.25s, box-shadow 0.25s;
  }
  .pj__card:hover {
    border-color: color-mix(in srgb, var(--accent) 40%, var(--line));
    transform: translateY(-3px);
  }
  .pj__card--wide {
    background:
      radial-gradient(120% 90% at 100% 0%, var(--accent-soft), transparent 55%),
      var(--surface);
  }
  .pj__card--link { cursor: pointer; }
  .pj__card--link:hover .pj__arrow { transform: translate(3px, -3px); }

  .pj__dates { margin: 0; }

  .pj__title {
    margin: 12px 0 0;
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
    text-wrap: balance;
  }
  .pj__arrow { display: inline-block; vertical-align: -2px; margin-left: 4px; color: var(--accent); transition: transform 0.25s; }
  .pj__ctx { margin: 6px 0 0; font-size: var(--fs-small); color: var(--muted); }

  .pj__metric {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    margin: 18px 0 0;
    padding: 12px 0;
    border-top: 1px dashed var(--line);
    border-bottom: 1px dashed var(--line);
  }
  .pj__metric-v { font-size: 2.5rem; color: var(--accent); }
  .pj__metric-l { font-size: var(--fs-small); color: var(--text-2); }

  .pj__summary { margin: 16px 0 0; font-size: var(--fs-lead); font-weight: 500; color: var(--text); line-height: 1.45; text-wrap: pretty; }
  .pj__points { margin-top: 12px; }

  .pj__tags { margin-top: auto; padding-top: 20px; }
  .pj__cta { margin-top: 16px; font-size: var(--fs-small); font-weight: 700; color: var(--accent); }
</style>
